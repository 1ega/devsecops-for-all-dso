      "rule": "DSO Ptrace succeeded in container",
      "priority": "WARNING",
      "confidence": "MEDIUM",
      "attack": "T1055",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Debuggers and profilers are common legitimate sources; ptrace does not establish injection.",
