{
  "version": 1,
  "falco_version": "0.45.0",
  "rules": [
    {
      "id": "runtime.local.interactive-shell",
      "rule": "DSO Interactive shell in container",
      "priority": "WARNING",
      "confidence": "MEDIUM",
      "attack": "T1059",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Approved debugging creates the same event; identify the actor through Kubernetes audit logs.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1059/"
      ]
    },
    {
      "id": "runtime.local.web-shell",
      "rule": "DSO Web process spawned shell",
      "priority": "ERROR",
      "confidence": "MEDIUM",
      "attack": "T1059",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Direct parent names only; renamed processes, node/java/python apps and deeper ancestry need workload-specific rules.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1059/"
      ]
    },
    {
      "id": "runtime.local.credential-read",
      "rule": "DSO Credential file read in container",
      "priority": "WARNING",
      "confidence": "MEDIUM",
      "attack": "T1552",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Applications legitimately reading credentials need narrowly scoped exceptions; names do not cover every secret store.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1552/"
      ]
    },
    {
      "id": "runtime.local.service-account-token",
      "rule": "DSO Service account token read by utility",
      "priority": "WARNING",
      "confidence": "MEDIUM",
      "attack": "T1552",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Projected volumes may resolve to /run or ..data paths; SDK reads and alternate paths are outside this heuristic.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1552/"
      ]
    },
    {
      "id": "runtime.local.runtime-socket",
      "rule": "DSO Container accessed runtime socket",
      "priority": "ERROR",
      "confidence": "MEDIUM",
      "attack": "T1611",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Matches connections to docker.sock, containerd.sock, crio.sock or podman.sock at any path; renamed sockets and TCP-exposed runtime APIs are missed. Socket access alone does not prove escape.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1611/"
      ]
    },
    {
      "id": "runtime.local.temporary-executable",
      "rule": "DSO Executable launched from temporary directory",
      "priority": "WARNING",
      "confidence": "MEDIUM",
      "attack": "T1059",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Legitimate init and build jobs may execute here; renaming or executing in another writable directory evades this rule.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1059/"
      ]
    },
    {
      "id": "runtime.local.package-manager",
      "rule": "DSO Package manager in running container",
      "priority": "NOTICE",
      "confidence": "MEDIUM",
      "attack": "T1105",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Build containers and package-managed startup scripts are expected noise; execution does not prove installation.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1105/"
      ]
    },
    {
      "id": "runtime.local.network-discovery",
      "rule": "DSO Network discovery utility in container",
      "priority": "WARNING",
      "confidence": "MEDIUM",
      "attack": "T1046",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Process-name heuristic; renamed tools and application-native discovery are outside coverage.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1046/"
      ]
    },
