      "attack": "T1098",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Alert covers write-open, not rename, unlink, symlink, authorized_keys2 or authorized-keys commands.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1098/"
      ]
    },
    {
      "id": "runtime.local.scheduler-persistence",
      "rule": "DSO Scheduler or systemd configuration modified",
      "priority": "WARNING",
      "confidence": "MEDIUM",
      "attack": "T1053",
      "owner_role": "Platform or security owner",
      "response": "playbooks/runtime-alert.md",
      "limitations": "Provisioning and package upgrades cause noise; write-open does not cover atomic rename or every persistence location.",
      "source": "local",
      "license": "MIT",
      "references": [
        "https://falco.org/docs/reference/rules/supported-fields/",
        "https://attack.mitre.org/techniques/T1053/"
